{
  "realm": "workx",
  "enabled": true,
  "displayName": "WorkX",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "zh-CN"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "workx-web",
      "name": "WorkX (the API is the confidential OIDC client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "workx-local-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8000/api/v1/auth/callback",
        "http://localhost:8000/api/v1/auth/callback",
        "http://127.0.0.1:5173/api/v1/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/*##http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "alex@example.com",
      "email": "alex@example.com",
      "emailVerified": true,
      "firstName": "Alex",
      "lastName": "Chen",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "workx-dev-password",
          "temporary": false
        }
      ]
    }
  ]
}
